rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LEGACY shared config. Settings are now per-account (users/{uid}/settings/current).
    // Read kept ONLY so a signed-in user's first load can migrate values from here;
    // writing is no longer allowed. Safe to delete this block after every account
    // has logged in once (and the legacy doc has been removed).
    match /settings/global {
      allow read: if request.auth != null;
    }

    // Per-user chat history: a user can only touch their own session tree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
