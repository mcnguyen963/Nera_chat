rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Requires Firebase Authentication (the admin signs in via Email/Password).
    // Optional hardening: replace with `if request.auth.uid == "YOUR_ADMIN_UID";`
    // so only your specific account can touch the data.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
